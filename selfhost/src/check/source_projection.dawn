# One revision's declaration token facts, and whether two revisions spell a
# declaration the same way. This compares token spellings, not semantic cache
# eligibility. The caller must separately validate the parsed body and its
# dependencies.
#
# There is no coordinate mapping here any more. A typed span is an offset from
# the declaration that recorded it (`check/tast_positions`), so a declaration
# that moved needs nothing mapped, and admission separately requires the
# declaration's own bytes to be identical, so nothing inside it moved either.
# The two code-point tables that used to answer where each boundary went, and
# the assertion text they re-sliced, went with that requirement.
use std/map
use std/str
use front/lexer
use front/token.{Token, TokKind, NEWLINE, EOF}

type IndexedData = { text: String, cps: List[Char] }
pub opaque type Indexed = IndexedData

## Bind a code-point index to exactly the source snapshot that produced it.
## Repeated body projections must not seek from the whole file's beginning
## for every token slice. The original unindexed path remains an oracle.
pub fn index(text: String) -> Indexed = IndexedData { text: text, cps: code_points(text) }

## The same index from code points the caller already decoded.
##
## `code_points` is a whole pass over the text, and the lexer made this exact
## array on the way in: `parser.parse_module_lexed` hands back the array its
## own parse ran over. The caller owes the pairing, the way `index` owes it to
## itself: `cps` must be the code points of `text` and of nothing else.
pub fn index_cps(text: String, cps: List[Char]) -> Indexed =
  IndexedData { text: text, cps: cps }

## One declaration's token facts, taken once for the revision that owns them.
## A token's kind and spelling belong to one text, so they are read once per
## revision rather than once per pair, and pairing is then two list
## comparisons.
##
## `texts` is each token's source spelling. The lexer builds every token's
## `text` by copying the code points of `[lo, hi)`; construction re-checks the
## width so a token whose text is not its span is refused rather than
## trusted.
pub type Slice = { lo: Int, hi: Int, kinds: List[TokKind], texts: List[String] }

type TokensData = { text: String, slices: Map[Int, Slice] }

## One revision's declaration token facts. The representation stays private
## because a slice is only meaningful beside the text it was lexed from.
pub opaque type Tokens = TokensData

## Lex one revision once and keep the tokens of each named declaration range.
## `spans` is `(declaration index, lo, hi)`, ascending and disjoint; a range
## that does not begin and end on token boundaries keeps no slice, so a
## consumer asking for it is refused rather than given a partial lex.
pub fn tokens_of(indexed: Indexed, spans: List[(Int, Int, Int)]) -> Option[Tokens] = {
  let data: IndexedData = indexed
  let (all, diagnostics) = lexer.lex(data.text)
  if len(diagnostics) != 0 { return None }
  tokens_from(indexed, all, spans)
}

## The same slices from a token stream the caller already has.
##
## `parser.parse_module_lexed` hands back the tokens its own parse ran over,
## so a snapshot no longer lexes its revision a second time to learn what the
## parser already read. The tokens must be the whole stream of exactly this
## text, in lexer order; a caller that has not refused the revision's lexer
## diagnostics must refuse them here, because `tokens_of` refuses them and
## these slices cannot tell a recovered token from a clean one.
pub fn tokens_from(indexed: Indexed, all: List[Token],
  spans: List[(Int, Int, Int)]) -> Option[Tokens] = {
  let data: IndexedData = indexed
  var kept: List[Token] = []
  for t in all {
    if t.kind != NEWLINE && t.kind != EOF {
      if t.hi - t.lo != str.len(t.text) { return None }
      kept = kept ++ [t]
    }
  }
  var slices: Map[Int, Slice] = map.empty()
  var cursor = 0
  var previous = 0
  for (declaration, lo, hi) in spans {
    if lo < previous || hi < lo || hi > len(data.cps) { return None }
    previous = hi
    while cursor < len(kept) && kept[cursor].hi <= lo { cursor = cursor + 1 }
    var i = cursor
    var kinds: List[TokKind] = []
    var texts: List[String] = []
    var aligned = true
    while i < len(kept) && kept[i].lo < hi {
      let t = kept[i]
      if t.lo < lo || t.hi > hi { aligned = false }
      kinds = kinds ++ [t.kind]
      texts = texts ++ [t.text]
      i = i + 1
    }
    if aligned {
      slices = map.insert(slices, declaration, Slice { lo: lo, hi: hi, kinds: kinds, texts: texts })
    }
  }
  Some(TokensData { text: data.text, slices: slices })
}

## Pair two already-lexed declaration ranges. Equal kinds and equal spellings
## are the proof: the ranges are named by declaration so one revision's slice
## cannot answer for another's, and each slice is kept only when it begins and
## ends on token boundaries, so a range that cuts a token has no slice to
## answer with.
pub fn pair(old: Tokens, next: Tokens, old_declaration: Int, new_declaration: Int,
  old_lo: Int, old_hi: Int, new_lo: Int, new_hi: Int) -> Bool = {
  let a: TokensData = old
  let b: TokensData = next
  match (map.get(a.slices, old_declaration), map.get(b.slices, new_declaration)) {
    (Some(x), Some(y)) ->
      x.lo == old_lo && x.hi == old_hi && y.lo == new_lo && y.hi == new_hi &&
      x.kinds == y.kinds && x.texts == y.texts
    _ -> false
  }
}

## The two ranges are the same bytes, trivia included.
##
## This is the stronger question, and it is the one a saved body has to ask.
## `pair` is blind to whitespace between tokens by design, and a space added
## inside a declaration moves that declaration's interior without moving the
## declaration, which is exactly what an offset into it cannot survive.
pub fn same_text(old: Tokens, next: Tokens,
  old_lo: Int, old_hi: Int, new_lo: Int, new_hi: Int) -> Bool = {
  let a: TokensData = old
  let b: TokensData = next
  if old_lo < 0 || old_hi < old_lo || new_lo < 0 || new_hi < new_lo { return false }
  if old_hi - old_lo != new_hi - new_lo { return false }
  if old_hi > str.len(a.text) || new_hi > str.len(b.text) { return false }
  str.slice(a.text, old_lo, old_hi) == str.slice(b.text, new_lo, new_hi)
}

test "source projection pairs ranges on kinds and spellings and nothing else" {
  let old = "# 🌅\nfn answer(x: Int) -> Int = {\n let y = x+1\n y * 2\n}\n"
  let next = "# λ🌅 moved\n\nfn answer(x: Int) -> Int = {\n let y = x+1\n y * 2\n}\n"
  let old_lo = 4
  let old_hi = str.len(old)
  let new_lo = 12
  let new_hi = str.len(next)
  let left = tokens_of(index(old), [(0, old_lo, old_hi)]).expect("recorded tokens")
  let right = tokens_of(index(next), [(0, new_lo, new_hi)]).expect("candidate tokens")
  assert pair(left, right, 0, 0, old_lo, old_hi, new_lo, new_hi)
  # the same declaration moved, spelled the same way and to the byte
  assert same_text(left, right, old_lo, old_hi, new_lo, new_hi)
  # an unknown declaration index has no slice to answer with, and a range that
  # is not the one the slice was taken at is not that slice
  assert not pair(left, right, 1, 0, old_lo, old_hi, new_lo, new_hi)
  assert not pair(left, right, 0, 0, old_lo, old_hi - 1, new_lo, new_hi)
}

test "source projection refuses a changed spelling and a changed token count" {
  let old = "fn answer(x: Int) -> Int = {\n let y = x + 1\n y * 2\n}\n"
  let renamed = "fn answer(x: Int) -> Int = {\n let z = x + 1\n z * 2\n}\n"
  let longer = "fn answer(x: Int) -> Int = {\n let y = x + 1 + 0\n y * 2\n}\n"
  let left = tokens_of(index(old), [(0, 0, str.len(old))]).expect("recorded tokens")
  for other in [renamed, longer] {
    let right = tokens_of(index(other), [(0, 0, str.len(other))]).expect("candidate tokens")
    assert not pair(left, right, 0, 0, 0, str.len(old), 0, str.len(other))
    assert not same_text(left, right, 0, str.len(old), 0, str.len(other))
  }
}

test "source projection pairs whitespace inside a declaration but not its bytes" {
  # This is the whole reason the byte comparison exists. Both revisions lex to
  # the same tokens, so the pairing is happy; every offset into the
  # declaration's interior moved, so a saved body measured against it is not.
  let old = "fn answer(x: Int) -> Int = x+1\n"
  let spaced = "fn answer(x: Int) -> Int = x + 1\n"
  let left = tokens_of(index(old), [(0, 0, str.len(old) - 1)]).expect("recorded tokens")
  let right = tokens_of(index(spaced), [(0, 0, str.len(spaced) - 1)]).expect("candidate tokens")
  assert pair(left, right, 0, 0, 0, str.len(old) - 1, 0, str.len(spaced) - 1)
  assert not same_text(left, right, 0, str.len(old) - 1, 0, str.len(spaced) - 1)
}

test "source projection keeps no slice for a range that cuts a token" {
  let text = "fn answer() -> Int = 42\n"
  let whole = str.len(text) - 1
  let cut = tokens_of(index(text), [(0, 1, whole)]).expect("cut tokens")
  let full = tokens_of(index(text), [(0, 0, whole)]).expect("aligned tokens")
  assert not pair(cut, full, 0, 0, 1, whole, 0, whole)
  assert pair(full, full, 0, 0, 0, whole, 0, whole)
}

test "source projection token slices keep every lexer span and spelling" {
  let text = "fn f(x: Int) -> Int = {\n let a = \"s t\"\n let b = 'c'\n let d = 1.5e3\n let e = x >= 1 && x != 2\n x\n}\n"
  let (all, diagnostics) = lexer.lex(text)
  assert diagnostics == []
  let cps = code_points(text)
  # Every token's `text` is the source slice of its own span. The paired
  # comparison compares spellings through that field instead of re-slicing.
  for t in all {
    if t.kind != NEWLINE && t.kind != EOF {
      assert t.text == lexer.slice_cps(cps, t.lo, t.hi)
      assert t.hi - t.lo == str.len(t.text)
    }
  }
}
