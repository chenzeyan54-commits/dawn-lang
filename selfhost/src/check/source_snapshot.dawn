# One revision's parsed module and the code-point index its body projections
# need, produced by a single parse and retained together.
#
# The cross-revision executor used to take two source `String`s and reparse
# both on every call, to prove that the coordinates inside a retained product
# still address the text it was handed. That proof cost more than checking the
# whole module cold: a 195 KB module paid roughly 156 ms of reparse against a
# 41 ms cold body check (measured 2026-09-12). The owner that produced the
# headers already parsed the revision, so the tree exists before replay is
# asked anything.
#
# Binding the tree to the text here keeps the same proof without the reparse:
# the tree in a snapshot is the tree of its own text by construction, so a
# consumer only has to compare it with the headers it was given.
use front/parser
use front/ast.{Module, Decl, DFn, DUseModule}
use check/source_projection

type SnapshotData = { syntax: Module, indexed: source_projection.Indexed,
  tokens: source_projection.Tokens }

## One revision's replay inputs. The representation stays private because the
## pairing is the whole guarantee: no caller can put one revision's tree
## beside another revision's code points.
pub opaque type Snapshot = SnapshotData

## Parse and index one revision, once. A module that does not parse cleanly
## has no snapshot: the coordinates of a recovered tree are not evidence about
## the text, and every consumer here refuses such a revision anyway.
##
## One lex serves all three results. The parser decodes the text and lexes it
## to build the tree, so asking it for both back leaves the index and the
## token facts with no pass of their own: this used to decode the text twice
## and lex it twice, which was about a quarter of the construction. Refusing
## the revision on any diagnostic refuses an unclean token stream too, since
## the parse's diagnostics open with the lexer's.
pub fn of(text: String) -> Option[Snapshot] = {
  let (syntax, diagnostics, cps, toks) = parser.parse_module_lexed(text)
  if diagnostics != [] { return None }
  let indexed = source_projection.index_cps(text, cps)
  var spans: List[(Int, Int, Int)] = []
  var declaration = 0
  for decl in syntax.decls {
    match decl {
      DFn(d) -> { spans = spans ++ [(declaration, d.lo, d.hi)] }
      _ -> ()
    }
    declaration = declaration + 1
  }
  let tokens = source_projection.tokens_from(indexed, toks, spans)?
  Some(SnapshotData { syntax: syntax, indexed: indexed, tokens: tokens })
}

## The tree this snapshot parsed. The owner checks headers from exactly this
## value, so the revision is parsed once; a consumer compares it against the
## headers it was handed to prove both describe the same revision.
pub fn syntax(s: Snapshot) -> Module = {
  let data: SnapshotData = s
  data.syntax
}

## The loader resolves package imports without changing their source spelling.
## Admit only that transformation: every body, declaration order, alias,
## selection and coordinate must still come from this snapshot's own parse.
## Resolution is not semantic equivalence; current headers and query answers
## still validate what these paths name before any body may be reused.
pub fn resolved(s: Snapshot, candidate: Module) -> Option[Snapshot] = {
  let data: SnapshotData = s
  if len(data.syntax.decls) != len(candidate.decls) { return None }
  var index = 0
  for original in data.syntax.decls {
    let changed = candidate.decls[index]
    match (original, changed) {
      (DUseModule(_, selection, aname, lo, hi, nlo, nhi), DUseModule(path, _, _, _, _, _, _)) -> {
        if path == [] || changed != DUseModule(path, selection, aname, lo, hi, nlo, nhi) { return None }
      }
      _ -> if original != changed { return None }
    }
    index = index + 1
  }
  Some(SnapshotData { ..data, syntax: candidate })
}

## The code-point index of the same text, for token projection.
pub fn indexed(s: Snapshot) -> source_projection.Indexed = {
  let data: SnapshotData = s
  data.indexed
}

## The per-declaration token facts of the same text, lexed once with it.
## Function declarations only: those are the ranges a cross-revision executor
## pairs, and a range with no slice is refused rather than lexed on demand.
pub fn tokens(s: Snapshot) -> source_projection.Tokens = {
  let data: SnapshotData = s
  data.tokens
}

## The construction this module replaced, kept as the oracle for the one-lex
## path: parse the text, decode it a second time, lex it a third. Every stored
## field has to come out the same, and a revision the old path refused has to
## stay refused.
fn separately_lexed(text: String) -> Option[SnapshotData] = {
  let (syntax, diagnostics) = parser.parse_module(text)
  if diagnostics != [] { return None }
  let indexed = source_projection.index(text)
  var spans: List[(Int, Int, Int)] = []
  var declaration = 0
  for decl in syntax.decls {
    match decl {
      DFn(d) -> { spans = spans ++ [(declaration, d.lo, d.hi)] }
      _ -> ()
    }
    declaration = declaration + 1
  }
  let tokens = source_projection.tokens_of(indexed, spans)?
  Some(SnapshotData { syntax: syntax, indexed: indexed, tokens: tokens })
}

fn opened(text: String) -> Option[SnapshotData] = match of(text) {
  Some(s) -> {
    let data: SnapshotData = s
    Some(data)
  }
  None -> None
}

test "source snapshot stores what a separately lexed revision stores" {
  # The module fixtures of this file and of source_projection, a revision the
  # lexer itself rejects (unterminated string), and one whose second
  # declaration only survives because `sync_decl` resynchronizes past a broken
  # first one. The last two have diagnostics, so both paths must refuse them.
  let broken_lex = "fn f() -> String = \"oops\nfn g() -> Int = 1\n"
  let recovered = "fn broken( -> Int = 42\nfn after() -> Int = 1\n"
  for text in ["# 🌅\nfn answer() -> Int = 42\n",
    "fn f(x: Int) -> Int = {\n let a = \"s t\"\n let b = 'c'\n x\n}\n",
    "# λ🌅 moved\n\nfn answer(x: Int) -> Int = {\n let y = x + 1\n y * 2\n}\n",
    "const K: Int = 1\nfn uses() -> Int = K\ntest \"t\" { assert true }\n",
    "", broken_lex, recovered] {
    let built = opened(text)
    let oracle = separately_lexed(text)
    assert built == oracle
    match (built, oracle) {
      (Some(a), Some(b)) -> {
        assert a.syntax == b.syntax
        assert a.indexed == b.indexed
        assert a.tokens == b.tokens
      }
      (None, None) -> ()
      _ -> panic("one path built a snapshot and the other refused")
    }
  }
  assert match separately_lexed(broken_lex) { None -> true, Some(_) -> false }
  assert match separately_lexed(recovered) { None -> true, Some(_) -> false }
}

test "source snapshot pairs one parse with the index of its own text" {
  let text = "# 🌅\nfn answer() -> Int = 42\n"
  let snapshot = of(text).expect("clean revision")
  let (parsed, diagnostics) = parser.parse_module(text)
  assert diagnostics == []
  assert syntax(snapshot) == parsed
  assert match of("fn broken( -> Int = 42\n") { None -> true, Some(_) -> false }
  # the snapshot's own declaration slice answers for itself, both ways
  assert source_projection.pair(tokens(snapshot), tokens(snapshot), 0, 0, 4, 27, 4, 27)
  assert source_projection.same_text(tokens(snapshot), tokens(snapshot), 4, 27, 4, 27)
}

test "source snapshot resolution changes only import paths" {
  let source = of("use helper\nfn answer() -> Int = helper.value()\n").expect("source")
  let original = syntax(source)
  let first = original.decls[0]
  let body = original.decls[1]
  let rewritten: Decl = match first {
    DUseModule(_, selection, aname, lo, hi, nlo, nhi) ->
      DUseModule(["package", "helper"], selection, aname, lo, hi, nlo, nhi)
    _ -> panic("import fixture")
  }
  let target = Module { decls: [rewritten, body] }
  let bound = resolved(source, target).expect("resolved import")
  assert syntax(bound) == target
  assert indexed(bound) == indexed(source)
  assert tokens(bound) == tokens(source)
  assert resolved(source, original) != None
  assert resolved(bound, original) != None
  assert resolved(source, Module { decls: [rewritten] }) == None
  assert resolved(source, Module { decls: [body, rewritten] }) == None
  let other = syntax(of("use helper\nfn answer() -> Int = helper.other()\n").expect("changed body"))
  assert resolved(source, Module { decls: [rewritten, other.decls[1]] }) == None
  let moved = syntax(of("use helper\n\nfn answer() -> Int = helper.value()\n").expect("moved body"))
  assert resolved(source, Module { decls: [rewritten, moved.decls[1]] }) == None
  match first {
    DUseModule(path, selection, aname, lo, hi, nlo, nhi) -> {
      for bad in [DUseModule([], selection, aname, lo, hi, nlo, nhi),
        DUseModule(path, selection, aname, lo + 1, hi, nlo, nhi),
        DUseModule(path, selection, aname, lo, hi + 1, nlo, nhi),
        DUseModule(path, selection, aname, lo, hi, nlo + 1, nhi),
        DUseModule(path, selection, aname, lo, hi, nlo, nhi + 1)] {
        assert resolved(source, Module { decls: [bad, body] }) == None
      }
    }
    _ -> panic("import fixture")
  }
  # Parse aliases and selections to exercise their actual AST representation.
  for text in ["use helper as renamed\nfn answer() -> Int = helper.value()\n",
    "use helper.{value}\nfn answer() -> Int = helper.value()\n"] {
    let changed = syntax(of(text).expect("import variant"))
    let forged: Decl = match (first, changed.decls[0]) {
      (DUseModule(path, _, _, lo, hi, nlo, nhi), DUseModule(_, selection, aname, _, _, _, _)) ->
        DUseModule(path, selection, aname, lo, hi, nlo, nhi)
      _ -> panic("import fixture")
    }
    assert resolved(source, Module { decls: [forged, body] }) == None
  }
}
