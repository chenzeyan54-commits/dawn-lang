# Semantic references have domains, and evidence keys encode a domain rather
# than containing a plain ID. Missing mappings fail closed so a caller can
# discard a memo and check cold. This foundation does not enable body caching
# or alter the checker ID stream.
#
# Nominal and trait references are absent from every map here. Those two
# domains derive their integers from the declaration itself
# (`check/identity.derive`), so the same declaration has the same id in both
# revisions and there is nothing for a table to record. What is left is the
# two binder domains and a body's own interval, all three of which are still
# allocations off a counter.
use std/map
use std/set
use std/str
use check/types.{
  Ty, TyInt, TyFloat, TyBool, TyString, TyBytes, TyUnit, TyNever, TyError,
  TyVar, TyAdt, TyList, TyMap, TySet, TyArray, TyJava, TyOpaque, TyAssoc, TyTuple, TyFn,
  Eff, EPure, EIo, EffVar, EffAssoc, EUnion, ELabeled,
  eff_union, eff_with_labels, label_key, var_key, assoc_key, key_is_label, key_is_variable,
  key_effect_id, key_trait_id, Sig, Sym,
  ev_label_name, ev_assoc_name, ev_var_name, sig_abi_eff, eff_labels, eff_vars, eff_assocs,
  EvidenceRole, LabelSlot, VariableSlot, AssociatedSlot
}
use check/tast.{WitRef, WForward, WConcrete, WApply}

## The interval a body allocates. Every ID in it was minted while checking
## that one body, so relocating it needs no ledger: the candidate revision
## mints a fresh interval of the same length and the correspondence is
## `target + (id - start)`. `evidence` overrides that arithmetic for the
## entry evidence parameters, whose ABI order follows the signature's own
## relocation rather than allocation order.
type Interval = { start: Int, count: Int, target: Int, evidence: Map[Int, Int] }

type Data = {
  type_vars: Map[Int, Int], effect_vars: Map[Int, Int],
  evidence: Map[Int, Int], intervals: List[Interval]
}

pub opaque type Ids = Data

fn injective(ids: Map[Int, Int]) -> Bool = {
  var seen: Set[Int] = set.empty()
  for value in map.values(ids) {
    if set.has(seen, value) { return false }
    seen = set.insert(seen, value)
  }
  true
}

## Include explicit identity entries for unchanged references. An absent key
## means unknown, not unchanged; mappings are validated once per relocation.
## This is the header half only. A body's own allocations are an interval, not
## a table, and `body_interval` adds them.
pub fn new(type_vars: Map[Int, Int], effect_vars: Map[Int, Int]) -> Option[Ids] = {
  for ids in [type_vars, effect_vars] {
    if not injective(ids) { return None }
  }
  # `var_key` is injective modulo 2^64 (multiplying by an odd number is), so
  # the encoded table is injective exactly when the table it encodes is, and
  # the band merge the old three-domain version had to guard against cannot
  # arise from one domain.
  var evidence: Map[Int, Int] = map.empty()
  for (old, next) in map.entries(effect_vars) {
    evidence = map.insert(evidence, var_key(old), var_key(next))
  }
  let none: List[Interval] = []
  Some(Data { type_vars: type_vars, effect_vars: effect_vars,
    evidence: evidence, intervals: none })
}

## Add the interval one body allocated. The relocation inside it is
## arithmetic, so the only questions left are whether the interval is well
## formed, whether it overlaps an interval this relocation already carries,
## and whether the evidence override is a permutation of it onto itself.
##
## Nothing here checks the interval against the header maps, because an ID is
## an allocation: a body's interval starts at the `next_id` its declaration
## was entered with, so every ID any header owns was minted before it and no
## ID is ever minted twice. That is the whole reason the per-ID reservation
## ledger this replaces could be deleted rather than reimplemented. Where the
## two could nonetheless be read as overlapping, the header maps answer first.
##
## More than one interval is carried where one declaration is checked as
## several boundaries: a function's parameter defaults are separate products
## with their own intervals, and the body that follows them refers to what
## they bound.
pub fn body_interval(owner: Ids, start: Int, count: Int, target: Int,
  evidence: Map[Int, Int]) -> Option[Ids] = {
  let ids: Data = owner
  if start < 0 || count < 0 || target < 0 || start + count < start || target + count < target { return None }
  for other in ids.intervals {
    if start < other.start + other.count && other.start < start + count { return None }
    if target < other.target + other.count && other.target < target + count { return None }
  }
  var moved_from: Set[Int] = set.empty()
  var moved_to: Set[Int] = set.empty()
  for (id, moved) in map.entries(evidence) {
    if id < start || id >= start + count { return None }
    if set.has(moved_to, moved) { return None }
    moved_from = set.insert(moved_from, target + id - start)
    moved_to = set.insert(moved_to, moved)
  }
  # The override permutes the interval's evidence entries among themselves.
  # Anything else would either leave the interval or collide with an ID the
  # plain shift already reaches.
  for moved in set.to_list(moved_to) { if not set.has(moved_from, moved) { return None } }
  if set.len(moved_to) != set.len(moved_from) { return None }
  Some(Data { ..ids, intervals: ids.intervals ++ [Interval { start: start, count: count,
    target: target, evidence: evidence }] })
}

## Whether this relocation carries exactly the interval a product recorded,
## landing where the caller is about to install it. A consumer installing a
## product asks this instead of walking the interval to rediscover the same
## three numbers, which is all the walk ever established.
pub fn carries_interval(owner: Ids, start: Int, count: Int, target: Int) -> Bool = {
  let ids: Data = owner
  for interval in ids.intervals {
    if interval.start == start && interval.count == count && interval.target == target { return true }
  }
  false
}

fn shifted(ids: Data, id: Int) -> Option[Int] = {
  for interval in ids.intervals {
    if id >= interval.start && id < interval.start + interval.count {
      return Some(interval.target + id - interval.start)
    }
  }
  None
}

## Type and effect variables come from two places. A declaration's binders
## are header allocations and live in the maps; a variable inference minted
## while checking a body is in that body's interval, and the interval answers
## for it by arithmetic. The two cannot both own an ID, because a header
## binder was minted before the body was entered; where a caller nonetheless
## hands in a relocation whose maps reach into an interval, the maps answer.
pub fn type_var(owner: Ids, id: Int) -> Option[Int] = { let ids: Data = owner
  match map.get(ids.type_vars, id) { Some(moved) -> Some(moved), None -> shifted(ids, id) }
}
pub fn effect_var(owner: Ids, id: Int) -> Option[Int] = { let ids: Data = owner
  match map.get(ids.effect_vars, id) { Some(moved) -> Some(moved), None -> shifted(ids, id) }
}

## Locals have no header half at all: every symbol, dictionary, handler
## installation and evidence parameter a body names was minted inside that
## body's interval. The evidence override is the one thing that is not the
## plain shift, and it is only ever a permutation inside the interval.
pub fn local_id(owner: Ids, id: Int) -> Option[Int] = { let ids: Data = owner
  for interval in ids.intervals {
    if id >= interval.start && id < interval.start + interval.count {
      return Some(map.get(interval.evidence, id).unwrap_or(interval.target + id - interval.start))
    }
  }
  None
}
## A label key and an associated key name an effect and a trait, and neither
## of those moves any more, so both answer themselves. A variable key still
## has to be looked up, and an unknown one still fails closed.
pub fn evidence_key(owner: Ids, key: Int) -> Option[Int] = { let ids: Data = owner
  match map.get(ids.evidence, key) {
    Some(moved) -> Some(moved)
    None -> if key_is_variable(key) { None } else { Some(key) }
  }
}

## Recover provenance only from a compiler-owned evidence symbol's complete
## spelling, checked against the explicit source-domain maps.
pub fn symbol_evidence_role(owner: Ids, s: Sym) -> Option[EvidenceRole] = {
  let ids: Data = owner
  let key = s.ev_of?
  let _ = evidence_name(owner, s.name, key)?
  if key_is_label(key) { return Some(LabelSlot(key_effect_id(key))) }
  for old in map.keys(ids.effect_vars) {
    if var_key(old) == key { return Some(VariableSlot(old)) }
  }
  if key_is_variable(key) { return None }
  let tr = key_trait_id(key)
  for tv in map.keys(ids.type_vars) {
    let prefix = ev_assoc_name(tv, tr, "")
    if str.starts_with(s.name, prefix) && str.len(s.name) > str.len(prefix) {
      return Some(AssociatedSlot(tv, tr, str.slice(s.name, str.len(prefix), str.len(s.name))))
    }
  }
  None
}

# Evidence locals are compiler-owned names (ev_of is their provenance).
# Associated keys encode only the trait; their spelling also carries a tvar.
# Never guess how to rewrite an unrecognized generated name.
fn evidence_name(owner: Ids, name: String, key: Int) -> Option[String] = {
  let ids: Data = owner
  if key_is_label(key) {
    let prefix = ev_label_name(key_effect_id(key), "")
    if not str.starts_with(name, prefix) || str.len(name) == str.len(prefix) { return None }
    return Some(name)
  }
  for (old, next) in map.entries(ids.effect_vars) {
    if var_key(old) == key {
      if name != ev_var_name(old) { return None }
      return Some(ev_var_name(next))
    }
  }
  if key_is_variable(key) { return None }
  let tr = key_trait_id(key)
  for (tv, moved) in map.entries(ids.type_vars) {
    let prefix = ev_assoc_name(tv, tr, "")
    if str.starts_with(name, prefix) && str.len(name) > str.len(prefix) {
      return Some(ev_assoc_name(moved, tr, str.slice(name, str.len(prefix), str.len(name))))
    }
  }
  None
}

pub fn effect_row(ids: Ids, e: Eff) -> Option[Eff] =
  match e {
    EPure -> Some(EPure)
    EIo -> Some(EIo)
    EffVar(name, id) -> Some(EffVar(name, effect_var(ids, id)?))
    EffAssoc(subject, tv, tr, name) -> Some(EffAssoc(subject, type_var(ids, tv)?, tr, name))
    EUnion(vars, assocs, io) -> {
      var parts: List[Eff] = if io { [EIo] } else { [] }
      for (id, name) in vars { parts = parts ++ [EffVar(name, effect_var(ids, id)?)] }
      for (subject, tv, tr, name) in assocs {
        parts = parts ++ [EffAssoc(subject, type_var(ids, tv)?, tr, name)]
      }
      Some(eff_union(parts))
    }
    ELabeled(base, labels) -> {
      let moved = effect_row(ids, base)?
      var out: List[(Int, String)] = []
      for (id, name) in labels { out = out ++ [(id, name)] }
      Some(eff_with_labels(moved, out))
    }
  }

fn types(ids: Ids, ts: List[Ty]) -> Option[List[Ty]] = {
  var out: List[Ty] = []
  for t in ts { out = out ++ [ty(ids, t)?] }
  Some(out)
}

pub fn ty(ids: Ids, t: Ty) -> Option[Ty] =
  match t {
    TyInt -> Some(t)
    TyFloat -> Some(t)
    TyBool -> Some(t)
    TyString -> Some(t)
    TyBytes -> Some(t)
    TyUnit -> Some(t)
    TyNever -> Some(t)
    TyError -> Some(t)
    TyJava(_, _) -> Some(t)
    TyVar(name, id) -> Some(TyVar(name, type_var(ids, id)?))
    TyAdt(id, args) -> Some(TyAdt(id, types(ids, args)?))
    TyList(elem) -> Some(TyList(ty(ids, elem)?))
    TyMap(key, value) -> Some(TyMap(ty(ids, key)?, ty(ids, value)?))
    TySet(elem) -> Some(TySet(ty(ids, elem)?))
    TyArray(elem) -> Some(TyArray(ty(ids, elem)?))
    TyOpaque(id, name, owner, args, target) ->
      Some(TyOpaque(id, name, owner, types(ids, args)?, ty(ids, target)?))
    TyAssoc(subject, tr, name) -> Some(TyAssoc(ty(ids, subject)?, tr, name))
    TyTuple(elems) -> Some(TyTuple(types(ids, elems)?))
    TyFn(params, ret, eff) -> Some(TyFn(types(ids, params)?, ty(ids, ret)?, effect_row(ids, eff)?))
  }

## Binder and parameter order is lexical, unlike the normalized effect row.
## Remapping a signature does not by itself permute a call's evidence operands.
pub fn signature(ids: Ids, s: Sig) -> Option[Sig] = {
  var constraints: List[List[Int]] = []
  for bs in s.constraints {
    var moved: List[Int] = []
    for tr in bs { moved = moved ++ [tr] }
    constraints = constraints ++ [moved]
  }
  var eparams: List[Eff] = []
  for e in s.eparams { eparams = eparams ++ [effect_row(ids, e)?] }
  let trait_ref = s.trait_id
  let operation = s.op_of
  Some(Sig { ..s, param_tys: types(ids, s.param_tys)?, ret: ty(ids, s.ret)?,
    eff: effect_row(ids, s.eff)?, tparams: types(ids, s.tparams)?, constraints: constraints,
    eparams: eparams, trait_id: trait_ref, op_of: operation })
}

# Encoded evidence keys are not slot identities: two associated projections
# can share a trait key while having different subjects or member names.
fn evidence_slots(s: Sig) -> List[EvidenceRole] = {
  let abi = sig_abi_eff(s)
  var out: List[EvidenceRole] = []
  for (id, _) in eff_labels(abi) { out = out ++ [LabelSlot(id)] }
  for (id, _) in eff_vars(abi) { out = out ++ [VariableSlot(id)] }
  for (_, tv, tr, name) in eff_assocs(abi) { out = out ++ [AssociatedSlot(tv, tr, name)] }
  out
}

pub fn evidence_slot(ids: Ids, slot: EvidenceRole) -> Option[EvidenceRole] =
  match slot {
    LabelSlot(id) -> Some(LabelSlot(id))
    VariableSlot(id) -> Some(VariableSlot(effect_var(ids, id)?))
    AssociatedSlot(tv, tr, name) -> Some(AssociatedSlot(type_var(ids, tv)?, tr, name))
  }

## For each new ABI slot, return the corresponding old operand index.
## Operands themselves must be relocated separately, without re-evaluation.
## Include parameter-bound effect variables even for a pure function body.
pub fn evidence_permutation(ids: Ids, s: Sig) -> Option[List[Int]] =
  evidence_order(ids, s, signature(ids, s)?)

## The same permutation, for a caller that has already relocated the
## signature. Relocating it a second time is the largest part of the work and
## the answer is the same value.
pub fn evidence_order(ids: Ids, s: Sig, moved: Sig) -> Option[List[Int]] = {
  let target = evidence_slots(moved)
  var source: List[EvidenceRole] = []
  for slot in evidence_slots(s) { source = source ++ [evidence_slot(ids, slot)?] }
  if len(source) != len(target) { return None }
  var used: Set[Int] = set.empty()
  var out: List[Int] = []
  for slot in target {
    var found: Option[Int] = None
    var index = 0
    for candidate in source {
      if candidate == slot {
        if found != None { return None }
        found = Some(index)
      }
      index = index + 1
    }
    let old = found?
    if set.has(used, old) { return None }
    used = set.insert(used, old)
    out = out ++ [old]
  }
  Some(out)
}

test "relocation projects full evidence roles into the new ABI order" {
  let empty: Map[Int, Int] = map.empty()
  let swap = map.insert(map.insert(empty, 1, 20), 2, 10)
  let ids = new(swap, swap).expect("valid IDs")
  let s = Sig { name: "f", param_tys: [], param_names: [], param_defaults: [], ret: TyUnit,
    eff: eff_union([ELabeled(EPure, [(1, "A"), (2, "B")]),
      EffAssoc("T", 1, 3, "E"), EffAssoc("U", 2, 3, "E"), EffAssoc("U", 2, 3, "F")]),
    is_builtin: false, tparams: [], constraints: [], eparams: [EffVar("x", 1), EffVar("y", 2)],
    owner: None, trait_id: None, op_of: None, inferring: false }
  # the two labels keep their ids and so keep their places; the two effect
  # variables swap, and the three associated slots follow their type variables
  assert evidence_permutation(ids, s) == Some([0, 1, 3, 2, 5, 6, 4])
  assert evidence_permutation(ids, Sig { ..s, eff: EPure }) == Some([1, 0])
  assert evidence_permutation(ids, Sig { ..s, eff: EPure, eparams: [] }) == Some([])
  let missing = new(empty, empty).expect("empty mapping")
  assert evidence_permutation(missing, s) == None
}

## Source offsets are deliberately unchanged here: source-view projection is
## separate from identity relocation. A handler installation is a local ID,
## whereas ev_of holds an encoded atom key and dict_of is (trait, typevar).
pub fn sym(ids: Ids, s: Sym) -> Option[Sym] = {
  let name = match s.ev_of {
    Some(key) -> evidence_name(ids, s.name, key)?
    None -> s.name
  }
  let dictionary = match s.dict_of {
    Some((tr, tv)) -> Some((tr, type_var(ids, tv)?))
    None -> None
  }
  let evidence = match s.ev_of {
    Some(key) -> Some(evidence_key(ids, key)?)
    None -> None
  }
  let cell = match s.cell_of {
    Some((installation, value)) -> Some((local_id(ids, installation)?, ty(ids, value)?))
    None -> None
  }
  Some(Sym { ..s, name: name, ty: ty(ids, s.ty)?, dict_of: dictionary, ev_of: evidence, cell_of: cell })
}

pub fn witness(ids: Ids, w: WitRef) -> Option[WitRef] =
  match w {
    WForward(id) -> Some(WForward(local_id(ids, id)?))
    WConcrete(tr, subject) -> Some(WConcrete(tr, ty(ids, subject)?))
    WApply(tr, subject, args) -> {
      var moved: List[WitRef] = []
      for a in args { moved = moved ++ [witness(ids, a)?] }
      Some(WApply(tr, ty(ids, subject)?, moved))
    }
  }

test "relocation preserves slots and separates signature and symbol metadata" {
  let empty: Map[Int, Int] = map.empty()
  let headers = new(map.insert(empty, 0, 70), map.insert(empty, 0, 80)).expect("distinct reference domains")
  let ids = body_interval(headers, 1, 1, 90, map.empty()).expect("symbol interval")
  let old = Sig { name: "f", param_tys: [TyVar("T", 0)], param_names: ["x"], param_defaults: [true],
    ret: TyAdt(0, []), eff: EffVar("e", 0), is_builtin: false, tparams: [TyVar("T", 0)],
    constraints: [[0]], eparams: [EffVar("e", 0)], owner: Some("owner"), trait_id: Some(0),
    op_of: Some((0, 0)), inferring: false }
  # only the two binder domains move: the ADT, the trait and the operation's
  # effect are derived ids and are the same integer in both revisions
  let expected = Sig { ..old, param_tys: [TyVar("T", 70)], ret: TyAdt(0, []), eff: EffVar("e", 80),
    tparams: [TyVar("T", 70)], constraints: [[0]], eparams: [EffVar("e", 80)], trait_id: Some(0),
    op_of: Some((0, 0)) }
  assert signature(ids, old) == Some(expected)
  assert signature(ids, Sig { ..old, trait_id: None, op_of: None, eparams: [] }) ==
    Some(Sig { ..expected, trait_id: None, op_of: None, eparams: [] })
  let saved = Sym { name: "ev\$v\$0", ty: TyAdt(0, []), mutable: false, dlo: 0, dhi: 1,
    dict_of: Some((0, 0)), ev_of: Some(var_key(0)), cell_of: Some((1, TyVar("T", 0))) }
  let moved = Sym { ..saved, name: "ev\$v\$80", ty: TyAdt(0, []), dict_of: Some((0, 70)), ev_of: Some(var_key(80)),
    cell_of: Some((90, TyVar("T", 70))) }
  assert sym(ids, saved) == Some(moved)
  assert sym(ids, Sym { ..saved, dict_of: None, ev_of: None, cell_of: None }) ==
    Some(Sym { ..moved, name: saved.name, dict_of: None, ev_of: None, cell_of: None })
  assert sym(ids, Sym { ..saved, name: "ev\$0\$Ask", ev_of: Some(label_key(0)) }) ==
    Some(Sym { ..moved, name: "ev\$0\$Ask", ev_of: Some(label_key(0)) })
  assert sym(ids, Sym { ..saved, name: "ev\$a\$0\$0\$E", ev_of: Some(assoc_key(0)) }) ==
    Some(Sym { ..moved, name: "ev\$a\$70\$0\$E", ev_of: Some(assoc_key(0)) })
  assert sym(ids, Sym { ..saved, name: "unrecognized" }) == None
  # The three evidence bands are read back out of the key itself. A label
  # names an effect and an associated key names a trait, and neither of those
  # moves any more, so the arithmetic is the whole of the answer; a variable
  # is still only as good as the table entry behind it.
  let labelled = Sym { ..saved, name: "ev\$5\$Ask", ev_of: Some(label_key(5)) }
  assert sym(ids, labelled) == Some(Sym { ..moved, name: "ev\$5\$Ask", ev_of: Some(label_key(5)) })
  assert symbol_evidence_role(ids, labelled) == Some(LabelSlot(5))
  assert symbol_evidence_role(ids, saved) == Some(VariableSlot(0))
  assert symbol_evidence_role(ids, Sym { ..saved, name: "ev\$a\$0\$0\$E", ev_of: Some(assoc_key(0)) }) ==
    Some(AssociatedSlot(0, 0, "E"))
  assert symbol_evidence_role(ids, Sym { ..saved, ev_of: Some(var_key(1)) }) == None
  assert symbol_evidence_role(ids, Sym { ..saved, ev_of: None }) == None
  let w = WApply(0, TyVar("T", 0), [WConcrete(0, TyAdt(0, [])), WForward(1)])
  assert witness(ids, w) == Some(WApply(0, TyVar("T", 70), [WConcrete(0, TyAdt(0, [])), WForward(90)]))
  assert sym(ids, Sym { ..saved, dict_of: Some((1, 2)) }) == None
  assert sym(ids, Sym { ..saved, ev_of: Some(var_key(1)) }) == None
  assert sym(ids, Sym { ..saved, cell_of: Some((2, TyInt)) }) == None
  assert witness(ids, WApply(0, TyInt, [WForward(2)])) == None
}

test "relocation distinguishes domains and refuses missing or aliased IDs" {
  let empty: Map[Int, Int] = map.empty()
  let c = map.insert(empty, 0, 70)
  let d = map.insert(empty, 0, 80)
  let headers = new(c, d).expect("injective IDs")
  let ids = body_interval(headers, 1, 1, 90, map.empty()).expect("domain interval")
  assert type_var(ids, 0) == Some(70)
  assert effect_var(ids, 0) == Some(80)
  assert local_id(ids, 1) == Some(90)
  assert local_id(ids, 0) == None
  # a label and an associated key name a derived id, so they answer
  # themselves whether or not this relocation ever saw them
  assert evidence_key(ids, label_key(0)) == Some(label_key(0))
  assert evidence_key(ids, label_key(4242)) == Some(label_key(4242))
  assert evidence_key(ids, assoc_key(0)) == Some(assoc_key(0))
  assert evidence_key(ids, assoc_key(-1)) == Some(assoc_key(-1))
  assert evidence_key(ids, var_key(0)) == Some(var_key(80))
  # an unknown variable key is still unknown
  assert evidence_key(ids, var_key(1)) == None
  assert evidence_key(ids, var_key(-1)) == None
  assert ty(ids, TyAdt(1, [])) == Some(TyAdt(1, []))
  assert ty(ids, TyFn([], TyVar("T", 2), EPure)) == None
  assert effect_row(ids, EffAssoc("T", 0, 1, "E")) == Some(EffAssoc("T", 70, 1, "E"))
  assert effect_row(ids, EffAssoc("T", 2, 1, "E")) == None
  assert new(map.insert(c, 1, 70), d) == None
  assert new(c, map.insert(d, 1, 80)) == None
  let negative = new(empty, map.insert(empty, -1, -2)).expect("negative variable")
  assert evidence_key(negative, var_key(-1)) == Some(var_key(-2))
  # encoding is injective, so an encoded table is refused exactly when the
  # table it came from is
  assert new(empty, map.from([(0, 0), (6148914691236517205, 1)])) != None
  assert new(empty, map.from([(0, 0), (1, 0)])) == None
}

test "relocation renormalizes effect rows after nonmonotone ID changes" {
  let empty: Map[Int, Int] = map.empty()
  let swapped = map.insert(map.insert(empty, 1, 20), 2, 10)
  let ids = new(swapped, swapped).expect("permutation")
  # The labels are written out of order on purpose. Nothing in a relocation
  # reorders them any more -- a label names a derived id and keeps it -- so
  # the projector's own promise, that what comes out is a normalized row and
  # not whatever order it was handed, needs a row that is not already sorted.
  let row = ELabeled(EUnion([(1, "a"), (2, "b")], [("T", 1, 2, "E"), ("U", 2, 1, "F")], true),
    [(2, "Tell"), (1, "Ask")])
  # the labels and the trait references stay put; the variables swap, and the
  # row renormalizes around them
  let expected = ELabeled(EUnion([(10, "b"), (20, "a")], [("U", 10, 1, "F"), ("T", 20, 2, "E")], true),
    [(1, "Ask"), (2, "Tell")])
  assert effect_row(ids, row) == Some(expected)
  let original = TyOpaque(1, "Box", "owner", [TyVar("T", 2)],
    TyFn([TyAdt(2, [TyVar("T", 1)])], TyAssoc(TyVar("T", 2), 1, "Item"), row))
  let moved = TyOpaque(1, "Box", "owner", [TyVar("T", 10)],
    TyFn([TyAdt(2, [TyVar("T", 20)])], TyAssoc(TyVar("T", 10), 1, "Item"), expected))
  assert ty(ids, original) == Some(moved)
}

test "relocation traverses collection types and propagates missing references" {
  let empty: Map[Int, Int] = map.empty()
  let one = map.insert(empty, 1, 101)
  let ids = new(one, one).expect("single reference")
  let original = TyTuple([
    TyList(TyVar("T", 1)), TyMap(TyVar("T", 1), TySet(TyAdt(1, []))),
    TyArray(TyOpaque(1, "N", "owner", [], TyVar("T", 1)))
  ])
  let expected = TyTuple([
    TyList(TyVar("T", 101)), TyMap(TyVar("T", 101), TySet(TyAdt(1, []))),
    TyArray(TyOpaque(1, "N", "owner", [], TyVar("T", 101)))
  ])
  assert ty(ids, original) == Some(expected)
  for t in [TyInt, TyFloat, TyBool, TyString, TyBytes, TyUnit, TyNever, TyError,
    TyJava("java.lang.String", "String")] {
    assert ty(ids, t) == Some(t)
  }
  for t in [TyList(TyVar("U", 2)), TyMap(TyInt, TyVar("U", 2)), TySet(TyVar("U", 2)),
    TyArray(TyVar("U", 2)), TyTuple([TyInt, TyVar("U", 2)]),
    TyOpaque(1, "N", "owner", [], TyVar("U", 2)), TyAdt(1, [TyVar("U", 2)]),
    TyFn([], TyInt, EffVar("e", 2))] {
    assert ty(ids, t) == None
  }
  for e in [EffVar("e", 2), EffAssoc("T", 2, 1, "E"),
    EUnion([(1, "e"), (2, "f")], [], false)] {
    assert effect_row(ids, e) == None
  }
  # a label is a derived id: the row carries it through untouched
  assert effect_row(ids, ELabeled(EPure, [(2, "Ask")])) == Some(ELabeled(EPure, [(2, "Ask")]))
  assert effect_row(ids, EPure) == Some(EPure)
  assert effect_row(ids, EIo) == Some(EIo)
}

test "relocation shifts a body interval and permutes only its evidence" {
  let type_vars: Map[Int, Int] = map.from([(3, 13)])
  let effect_vars: Map[Int, Int] = map.from([(4, 14)])
  let base = new(type_vars, effect_vars).expect("header relocation")
  assert local_id(base, 5) == None && not carries_interval(base, 0, 0, 0)
  let empty: Map[Int, Int] = map.empty()
  let plain = body_interval(base, 20, 4, 40, empty).expect("plain interval")
  assert carries_interval(plain, 20, 4, 40) && not carries_interval(plain, 20, 5, 40)
  assert local_id(plain, 20) == Some(40) && local_id(plain, 23) == Some(43)
  assert local_id(plain, 19) == None && local_id(plain, 24) == None
  # The header maps answer first, and the interval answers for everything the
  # body minted itself.
  assert type_var(plain, 3) == Some(13) && type_var(plain, 21) == Some(41)
  assert effect_var(plain, 4) == Some(14) && effect_var(plain, 21) == Some(41)
  let permuted = body_interval(base, 20, 4, 40, map.from([(20, 41), (21, 40)])).expect("permuted interval")
  assert local_id(permuted, 20) == Some(41) && local_id(permuted, 21) == Some(40)
  assert local_id(permuted, 22) == Some(42)
  # The permutation does not move type or effect variables: their order is the
  # allocation order, not the evidence ABI order.
  assert type_var(permuted, 20) == Some(40) && effect_var(permuted, 21) == Some(41)
  # A second boundary of the same declaration adds its own interval, and an
  # interval that overlaps one already carried is refused.
  let following = body_interval(plain, 30, 1, 50, empty).expect("following interval")
  assert carries_interval(following, 20, 4, 40) && carries_interval(following, 30, 1, 50)
  assert local_id(following, 23) == Some(43) && local_id(following, 30) == Some(50)
  assert body_interval(plain, 23, 1, 50, empty) == None
  assert body_interval(plain, 30, 1, 43, empty) == None
  assert body_interval(base, -1, 4, 40, empty) == None
  assert body_interval(base, 20, -1, 40, empty) == None
  assert body_interval(base, 20, 4, -1, empty) == None
  # Evidence overrides that leave the interval, collide, or are not a
  # permutation of it are all refused.
  assert body_interval(base, 20, 4, 40, map.from([(19, 40)])) == None
  assert body_interval(base, 20, 4, 40, map.from([(24, 40)])) == None
  assert body_interval(base, 20, 4, 40, map.from([(20, 44)])) == None
  assert body_interval(base, 20, 4, 40, map.from([(20, 41), (21, 41)])) == None
  assert body_interval(base, 20, 4, 40, map.from([(20, 41)])) == None
}
