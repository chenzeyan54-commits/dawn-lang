# What one revision's semantic references become in another.
#
# Almost nothing, now. Every domain a reference can be in names the
# declaration it belongs to: nominal and trait ids derive from that
# declaration (`check/identity.derive`), and a type variable, an effect
# variable and a local symbol are `identity.pack` of their declaration and
# their slot inside it. A declaration that was not edited therefore binds the
# same integers in the candidate revision, whatever else the file gained or
# lost, so there is no table to record and no interval to shift.
#
# The half of this module that was never a mapping -- reading an evidence
# key's band back out of the key, and refusing a recorded symbol whose
# compiler-owned spelling does not match it -- is `check/evidence_spelling`
# now. It is an admission question rather than a translation, and it answers
# from the value in hand.
#
# The ABI permutation went the same way as the tables. An evidence row is
# sorted by effect id (`types.by_id`), an effect id derives from its
# declaration, and a declaration that was not edited derives the same id, so
# the row a signature lays out in the candidate revision is the row it laid
# out in the recorded one. Computing a permutation between them could only
# ever return the identity; what the computation really bought was the
# refusal of two signatures whose ABI rows do not correspond, and that
# question is now asked directly by comparing `types.nev` with the number of
# operands in hand.
use check/types.{Ty, Eff, TyInt, TyVar, TyAdt, TyFn, EffVar, EffAssoc, var_key}
use check/tast.{WitRef, WForward, WConcrete, WApply}

## A relocation carries nothing: one constructor and no fields. The type is
## still threaded by `View` and `HeaderView`, which is why it is here rather
## than deleted with the tables it used to hold; the knife that removes those
## removes this too.
pub type Ids = Relocation

pub fn new() -> Ids = Relocation

## A type, an effect row, a signature, a symbol and a witness all carry the
## same references in the candidate revision that they carried in the
## recorded one. These four are the identity, spelled out rather than deleted
## because their callers still describe a projection and the shape of that
## projection is what the next knife removes.
pub fn ty(ids: Ids, t: Ty) -> Option[Ty] = Some(t)

pub fn effect_row(ids: Ids, e: Eff) -> Option[Eff] = Some(e)

pub fn witness(ids: Ids, w: WitRef) -> Option[WitRef] = Some(w)

## An evidence key names an effect, a trait or an effect variable, and none of
## the three moves.
pub fn evidence_key(ids: Ids, key: Int) -> Option[Int] = Some(key)

test "relocation carries every reference domain it is handed" {
  let ids = new()
  # The four projections a view still calls. A declaration that was not
  # edited binds the same integers in the candidate revision, so each of
  # these is the value it was given; they are spelled out rather than
  # deleted because their callers still describe a projection.
  assert ty(ids, TyFn([TyVar("T", 1)], TyAdt(7, []), EffVar("e", 2))) ==
    Some(TyFn([TyVar("T", 1)], TyAdt(7, []), EffVar("e", 2)))
  assert effect_row(ids, EffAssoc("T", 1, 3, "E")) == Some(EffAssoc("T", 1, 3, "E"))
  assert witness(ids, WApply(3, TyVar("T", 1), [WConcrete(3, TyInt), WForward(9)])) ==
    Some(WApply(3, TyVar("T", 1), [WConcrete(3, TyInt), WForward(9)]))
  assert evidence_key(ids, var_key(4)) == Some(var_key(4))
}
