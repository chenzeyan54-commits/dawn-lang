test "scalar replay asks one candidate revision each shared question once" {
  # What the memo is for, measured rather than assumed: a module's bodies
  # repeat each other's questions, and the loop this replaced recomputed every
  # repetition. A module of eight functions over two nominal types and one
  # constant logs four facts for every one it can tell apart.
  let text = "type Shape = { width: Int, height: Int }\n" ++
    "type Flag = { on: Bool }\n" ++
    "const LIMIT: Int = 10\n" ++
    "fn one() -> Int = 1\n" ++
    "fn two(x: Int) -> Int = x + 1\n" ++
    "fn three(x: Int) -> Int = x * 2\n" ++
    "fn four(x: Int, y: Int) -> Int = x + y\n" ++
    "fn five(b: Bool) -> Bool = not b\n" ++
    "fn six(x: Int) -> Bool = x > LIMIT\n" ++
    "fn seven(s: Shape) -> Int = s.width\n" ++
    "fn eight(f: Flag) -> Bool = f.on\n"
  let snapshot = source_snapshot.of(text).expect("repetition snapshot")
  let observing = Cx { ..cx_new(Some("sample"), Some("sample.dawn")), function_reads: Some([]) }
  let headers = checker.check_module_headers(observing, source_snapshot.syntax(snapshot), map.empty())
  assert headers.cx.diags == []
  let facts = checker.check_module_body_products(headers).cx.function_reads.expect("module log")
  assert len(facts) > 2 * set.len(set.from(facts))
  # One real computation per distinct shareable fact, and strictly fewer
  # computations than questions. The verdict the memo returns is the verdict
  # the per-body loop returned, hit or miss, fact for fact.
  var memo = new_memo()
  var distinct: Set[FunctionRead] = set.empty()
  var questions = 0
  var computed = 0
  for fact in facts {
    if shared(fact) {
      questions = questions + 1
      distinct = set.insert(distinct, fact)
      match query_runtime.read(memo, fact).answer {
        query_runtime.Available(_) -> ()
        _ -> { computed = computed + 1 }
      }
      let (next_memo, verdict) = revalidated(memo, headers.cx, fact)
      memo = next_memo
      assert verdict == checker.revalidate_read(headers.cx, fact)
    }
  }
  assert questions > 0 && computed == set.len(distinct) && computed < questions
}

test "scalar replay carries one memo across the bodies of a revision and no further" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "fn answer() -> Int = 42\nfn other(x: Int) -> Int = x\n"
  let after = "type Added = { value: Int }\nfn other(x: Int) -> Int = x\n# moved\nfn answer() -> Int = 42\n"
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let new_syntax = source_snapshot.syntax(next_snapshot)
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, new_syntax, map.empty())
  assert old.cx.diags == [] && next.cx.diags == []
  let saved = body_execution.record(scope, old)
  let admitted: AdmittedData = admit(scope, old, old_snapshot, saved)
  # The memo travels with the revision rather than with the body: both
  # declarations here ask the same question, and only the first one pays for
  # the answer.
  var carried = prepare(admitted, next, next_snapshot).expect("prepared candidate revision")
  var questions = 0
  var answered_already = 0
  for (declaration, name) in [(1, "other"), (2, "answer")] {
    let d = match new_syntax.decls[declaration] { DFn(syntax) -> syntax, _ -> panic("declaration") }
    let sig = map.get(next.cx.fns, name).expect("candidate header")
    let (prior, _) = relocation(carried, next.cx, d, sig).expect("relocation")
    for fact in prior.product.function_reads.expect("recorded log") {
      if shared(fact) {
        questions = questions + 1
        match query_runtime.read(carried.memo, fact).answer {
          query_runtime.Available(_) -> { answered_already = answered_already + 1 }
          _ -> ()
        }
      }
    }
    let (after_body, product) = candidate(carried, next.cx, d, sig)
    assert product != None
    carried = after_body
  }
  assert questions == 2 && answered_already == 1
  # The production pass carries the same preparation, so the memo the module
  # ends with is the one its bodies filled.
  let (outcome, _) = checker.execute_module_bodies(next,
    Pass { counts: Counts { checked: 0, reused: 0 },
      prepared: prepare(admitted, next, next_snapshot) }, pass_executor())
  assert outcome.counts.reused == 2
  let finished = outcome.prepared.expect("carried preparation")
  let probe = AssignableType(TyInt, TyInt, true)
  assert shared(probe)
  assert match query_runtime.read(finished.memo, probe).answer {
    query_runtime.Available(value) -> value == Some(true)
    _ -> false
  }
  # A memo belongs to the revision that prepared it. Another preparation of
  # the same recording starts with nothing answered, so no verdict crosses
  # from one candidate revision into another.
  let fresh = prepare(admitted, next, next_snapshot).expect("second preparation")
  assert match query_runtime.read(fresh.memo, probe).answer {
    query_runtime.Needs(_) -> true
    _ -> false
  }
}
