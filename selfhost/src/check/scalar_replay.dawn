# Exercise cross-revision admission at the real scheduler boundary before
# general queries have reconstructible local contexts. This deliberately
# producer class has primitive compatibility observations and lexically proven
# local references, with no callees. Unsupported bodies stay cold.
# This is an opt-in module executor, not the incremental session entry point.
use std/map
use std/set
use check/checker
use check/checker.{ModuleHeaders, ModuleBodies, BodyExecutor}
use check/cx.{Cx, Frame, cx_new}
use check/types.{Ty, TyInt, TyFloat, TyBool, TyUnit, Sig, Sym, EPure}
use check/tast.{TFun}
use check/body_execution
use check/body_execution.{Recorded, SavedFunction, FunctionInput}
use check/body_product
use check/body_product.{Product, BodyProduct}
use check/identity
use check/identity.{ModuleKey, DeclKey}
use check/allocation
use check/relocate.{Ids}
use check/scalar_shape
use check/write_journal.{SymbolKey}
use check/source_projection
use check/source_snapshot
use check/source_snapshot.{Snapshot}
use check/relocate_tree
use check/relocate_tree.{View}
use check/semantic_reads.{AssignableType}
use front/ast.{FnDecl, DFn}

pub type Replayed = { bodies: ModuleBodies, checked: Int, reused: Int }
type Counts = { checked: Int, reused: Int }

## One saved body, with every admission question the recorded revision can
## answer on its own already answered. The candidate revision cannot change
## any of these, so they are settled once beside the recording rather than
## once per replay per body.
type Prior = { syntax: FnDecl, signature: Sig, product: Product, declaration: Int,
  binders: List[String], symbols: Map[Int, Sym] }

type Ready = { headers: allocation.Table, source: Snapshot, entries: Map[DeclKey, Prior] }
type AdmittedData = { scope: ModuleKey, ready: Option[Ready] }

## A recorded revision prepared for replay. The representation stays private
## because the pairing is the guarantee: the snapshot inside is the one whose
## headers produced these products, and no caller can substitute another.
pub opaque type Admitted = AdmittedData

type Prepared = { scope: ModuleKey, ready: Ready, headers: Ids,
  candidates: Map[Int, (DeclKey, Int)], callees: relocate_tree.CalleeIndex,
  old_tokens: source_projection.Tokens, tokens: source_projection.Tokens }

fn primitive(t: Ty) -> Bool = match t {
  TyInt -> true, TyFloat -> true, TyBool -> true, TyUnit -> true, _ -> false
}

## The half of class membership decidable from the declaration header, and the
## parameter names the body may refer to. Walking the body is the other half,
## and admission runs that walk once, pairing the two revisions, rather than
## once per revision.
fn parameters(d: FnDecl, s: Sig) -> Option[Set[String]] = {
  if d.tparams != [] || d.eparams != [] || d.effs != [] || d.ret == None ||
    s.tparams != [] || s.eparams != [] || len(s.constraints) != 0 || s.eff != EPure ||
    s.inferring || s.is_builtin || s.trait_id != None || not primitive(s.ret) ||
    len(d.params) != len(s.param_tys) || len(d.params) != len(s.param_names) { return None }
  for present in s.param_defaults { if present { return None } }
  var bound: Set[String] = set.empty()
  var i = 0
  for param in d.params {
    if param.default != None || param.name != s.param_names[i] ||
      not primitive(s.param_tys[i]) || set.has(bound, param.name) { return None }
    bound = set.insert(bound, param.name)
    i = i + 1
  }
  Some(bound)
}

fn table(scope: ModuleKey, h: ModuleHeaders) -> Option[allocation.Table] =
  allocation.combine([allocation.compiler_headers(scope.world)?,
    allocation.table(allocation.local_headers(scope, h.syntax, h.cx)?)?])

## A snapshot parsed its own text, so comparing its tree with the headers is
## the whole provenance check: equal trees mean the retained coordinates
## address this revision. Nothing is lexed or parsed here.
fn snapshot_matches(h: ModuleHeaders, s: Snapshot) -> Bool = source_snapshot.syntax(s) == h.syntax

## Settle one saved body against its own revision. Class membership, the
## product's own field guards, the local symbols it installs and the binder
## names it declares all read the recorded revision only; a candidate that
## fails the pairing below never reaches a product, and one that passes it has
## the same shape and the same binder names, so these answers carry over.
## Refusing here is refusing to record an admission verdict, not refusing a
## body: an unadmitted body is checked cold like any other.
fn recorded(prior: FnDecl, prior_sig: Sig, p: Product, declaration: Int) -> Option[Prior] = {
  # Class membership of the recorded declaration is settled by
  # `scalar_shape.binders` below, which fails closed on every node this class
  # does not support. The replay path settles the candidate's: `parameters`
  # accepts its header, `allocation.body_relocation` requires the recorded header to be
  # it field for field, and `source_projection.same_text` requires the
  # declaration's own bytes, so the candidate body is the recorded body.
  if p.tree.sig != prior_sig || p.tree.name != prior.name ||
    p.signatures != [] || p.aliases != [] || len(p.bounds) != 0 || p.diagnostics != [] { return None }
  let reads = p.function_reads?
  if reads == [] { return None }
  for read in reads {
    match read {
      AssignableType(a, b, true) -> if not primitive(a) || not primitive(b) { return None }
      _ -> return None
    }
  }
  var symbols: Map[Int, Sym] = map.empty()
  for change in p.symbols {
    let symbol = change.value?
    if map.has(symbols, change.key) || not primitive(symbol.ty) || symbol.mutable ||
      symbol.dict_of != None || symbol.ev_of != None || symbol.cell_of != None { return None }
    symbols = map.insert(symbols, change.key, symbol)
  }
  var written: Set[Int] = set.empty()
  for write in p.body_writes? {
    match write {
      SymbolKey(id) -> {
        if not map.has(symbols, id) { return None }
        written = set.insert(written, id)
      }
      _ -> return None
    }
  }
  if set.len(written) != map.len(symbols) { return None }
  # checker.declare reports a binder that shadows an imported module alias,
  # and that table read leaves no journal entry to revalidate. Name every
  # binder the recorded body declares so the candidate revision can be asked
  # the same question without walking its body a second time.
  let names = scalar_shape.binders(prior.body, prior_sig.param_names)?
  Some(Prior { syntax: prior, signature: prior_sig, product: p, declaration: declaration,
    binders: names, symbols: symbols })
}

fn ready(scope: ModuleKey, old: ModuleHeaders, old_source: Snapshot, saved: Recorded) -> Option[Ready] = {
  if old.cx.diags != [] || not snapshot_matches(old, old_source) { return None }
  let headers = table(scope, old)?
  var originals: Map[DeclKey, (FnDecl, Int)] = map.empty()
  for entry in identity.declarations(scope, old.syntax) {
    match old.syntax.decls[entry.declaration] {
      DFn(d) -> { originals = map.insert(originals, entry.key, (d, entry.declaration)) }
      _ -> ()
    }
  }
  var entries: Map[DeclKey, Prior] = map.empty()
  var seen: Set[DeclKey] = set.empty()
  for entry in saved.entries {
    match entry {
      SavedFunction(k, FunctionInput(prior, prior_sig, false), product) -> {
        if set.has(seen, k) {
          entries = map.remove(entries, k)
        } else {
          seen = set.insert(seen, k)
          match map.get(originals, k) {
            Some((declared, declaration)) -> {
              if declared == prior && map.get(old.cx.fns, prior.name) == Some(prior_sig) {
                match recorded(prior, prior_sig, product, declaration) {
                  Some(entry_value) -> { entries = map.insert(entries, k, entry_value) }
                  None -> ()
                }
              }
            }
            None -> ()
          }
        }
      }
      _ -> ()
    }
  }
  Some(Ready { headers: headers, source: old_source, entries: entries })
}

## Bind one recording to the revision that produced it, and answer every
## admission question that revision can answer alone. This is the record-time
## half of admission: it runs once per recorded revision, not once per replay,
## and never per candidate body.
pub fn admit(scope: ModuleKey, old: ModuleHeaders, old_source: Snapshot, saved: Recorded) -> Admitted =
  AdmittedData { scope: scope, ready: ready(scope, old, old_source, saved) }

## How many recorded bodies this admission settled. Observable so a caller
## can tell "nothing was admitted" from "nothing was offered"; it grants no
## access to the products themselves.
pub fn admitted_count(admitted: Admitted) -> Int = {
  let data: AdmittedData = admitted
  match data.ready { None -> 0, Some(settled) -> map.len(settled.entries) }
}

fn prepare(admitted: AdmittedData, next: ModuleHeaders, source: Snapshot) -> Option[Prepared] = {
  let scope = admitted.scope
  let settled = admitted.ready?
  let next_headers = table(scope, next)?
  let headers = allocation.between(settled.headers, next_headers)?
  # The candidate revision's own declaration keys, addressed by where each
  # declaration starts. A body reaches the executor as syntax, and this is
  # what turns that syntax back into the identity the enumeration gave it,
  # rather than spelling a key out of the declaration's name a second time.
  # A name that two declarations in this revision claim has no key here at
  # all: `identity.located` drops it, and a product keyed by it is therefore
  # unreachable.
  var candidates: Map[Int, (DeclKey, Int)] = map.empty()
  for located in identity.located(scope, next.syntax) {
    match next.syntax.decls[located.entry.declaration] {
      DFn(_) -> if located.entry.member == None {
        candidates = map.insert(candidates, located.span.lo, (located.entry.key, located.entry.declaration))
      }
      _ -> ()
    }
  }
  # The candidate revision's function tables, keyed once by the pair a call
  # site names. It belongs here for the same reason the header relocation does:
  # `prepare` runs once per candidate revision, `relocation` runs once per
  # body, and a table built per body would cost a module-sized pass per body.
  # It is built from the header revision's `cx`, which is the revision these
  # products are relocated onto.
  Some(Prepared { scope: scope, ready: settled, headers: headers, candidates: candidates,
    callees: relocate_tree.callee_index(next.cx),
    old_tokens: source_snapshot.tokens(settled.source), tokens: source_snapshot.tokens(source) })
}

## The recorded body paired with the relocation onto this candidate: every
## admission question that needs both revisions, and nothing that needs the
## product. Separate from `candidate` so the equivalence of the two
## revalidation paths can be asserted on the same relocation the production
## path builds.
fn relocation(prepared: Prepared, cx: Cx, d: FnDecl, sig: Sig) -> Option[(Prior, View)] = {
  if cx.diags != [] { return None }
  let _ = parameters(d, sig)?
  # The product is retained under the key of the declaration that produced it,
  # so this is the whole of finding it: ask the candidate revision which
  # declaration this is, and look the product up under that. A declaration
  # this revision spells the same way but reads as another identity, and a
  # reorder that moves a name onto another declaration, both land on a
  # different key and find nothing.
  let (key, declaration) = map.get(prepared.candidates, d.lo)?
  let saved = map.get(prepared.ready.entries, key)?
  let prior = saved.syntax
  let prior_sig = saved.signature
  let p = saved.product
  # `parameters` proved the candidate declaration binds exactly `sig`'s
  # parameter names, so equal names make the recorded binder list describe
  # this body too. The rest of the header is relocated field for field by the
  # interval below, which refuses unless the recorded signature carries onto
  # this one, and the declaration's own bytes are required further down.
  if prior_sig.param_names != sig.param_names { return None }
  for name in saved.binders {
    if map.has(cx.module_aliases, name) { return None }
  }
  let no_evidence: List[Int] = []
  let ids = allocation.body_relocation(prepared.headers, prior_sig, sig, no_evidence)?
  # Both revisions lexed their own declarations once, and pairing them is two
  # list comparisons over kinds and spellings. That is the snapshot's own
  # equality, and it says the recorded coordinates address this declaration in
  # each revision.
  if not source_projection.pair(prepared.old_tokens, prepared.tokens,
    saved.declaration, declaration, prior.lo, prior.hi, d.lo, d.hi) { return None }
  # This is the admission point for the positions. The product's spans are
  # offsets into the declaration's own text, so they mean the same thing in
  # this revision exactly when that text is the same bytes. The pairing above
  # is deliberately blind to whitespace between tokens, and whitespace between
  # two tokens of this declaration moves everything after it: the declaration
  # itself did not move, but every offset into it did. Such an edit is not
  # admitted, and its declaration is checked cold, which is the whole of the
  # rule.
  if not source_projection.same_text(prepared.old_tokens, prepared.tokens,
    prior.lo, prior.hi, d.lo, d.hi) { return None }
  let view = View { ids: ids,
    symbols: saved.symbols,
    # Admission is closed to named calls: `scalar_shape.binders` pairs no
    # call node and `recorded` accepts no read but `AssignableType`, so no
    # admitted body has a callee to resolve. Widening this class consumes
    # `prepared.callees`; until then the relocation refuses every call node.
    callee: (owner, name, builtin, trait_id) => None }
  Some((saved, view))
}

fn candidate(prepared: Prepared, cx: Cx, d: FnDecl, sig: Sig) -> Option[Product] = {
  let (saved, view) = relocation(prepared, cx, d, sig)?
  let p = saved.product
  # The recorded log is revalidated where it lies. Each fact is walked beside
  # the answer the candidate revision observes, with this relocation applied
  # one identity at a time, so nothing is rebuilt in candidate coordinates to
  # be compared and thrown away. The rebuilt log is only what an observing
  # caller installs, so it is built only when the caller is observing.
  let mapping = body_product.read_mapping(view, (owner, source) => None)
  for read in p.function_reads? {
    if checker.revalidate_read_under(mapping, cx, read) != Some(true) { return None }
  }
  let moved = match cx.function_reads {
    None -> body_product.project_without_reads(view, p)?
    Some(_) -> body_product.project(view, p)?
  }
  # These fields pass through this closed producer unchanged. The old final
  # value is not a write: preserve the corresponding current scheduler state.
  Some(BodyProduct { ..moved, in_test: cx.in_test, const_cutoff: cx.const_cutoff,
    loop_jumps: cx.loop_jumps, take_cell: cx.take_cell,
    function_reads: match cx.function_reads { None -> None, Some(_) -> moved.function_reads },
    body_writes: match cx.body_writes { None -> None, Some(_) -> moved.body_writes },
    frame: Frame { ..moved.frame, isolated: cx.frame.isolated } })
}

## Inputs must come from the canonical header/recording producers in one
## owner world. Both source snapshots carry the tree of their own text, and
## each must equal the headers it accompanies, so unrelated text cannot lend
## positions to those products. Every failed admission executes the cold body.
pub fn replay(admitted: Admitted, next: ModuleHeaders, source: Snapshot) -> Replayed !io = {
  let data: AdmittedData = admitted
  let valid = next.cx.diags == [] && snapshot_matches(next, source)
  let prepared: Option[Prepared] = if valid { prepare(data, next, source) } else { None }
  let cold: BodyExecutor[Counts] = checker.cold_body_executor()
  let executor: BodyExecutor[Counts] = BodyExecutor {
    function: (count, cx, d, sig) => {
      let hit: Option[Product] = match prepared {
        Some(p) -> candidate(p, cx, d, sig)
        None -> None
      }
      match hit {
        Some(product) -> match body_product.assemble(cx, product) {
          Some(after) -> (Counts { ..count, reused: count.reused + 1 }, after, product.tree)
          None -> cold.function(Counts { ..count, checked: count.checked + 1 }, cx, d, sig)
        }
        None -> cold.function(Counts { ..count, checked: count.checked + 1 }, cx, d, sig)
      }
    },
    inferred_body: (n, cx, d, sig) => cold.inferred_body(Counts { ..n, checked: n.checked + 1 }, cx, d, sig),
    constant: (n, cx, d, ty, visible) => cold.constant(Counts { ..n, checked: n.checked + 1 }, cx, d, ty, visible),
    method: (n, cx, tr, subject, d, sig) => cold.method(Counts { ..n, checked: n.checked + 1 }, cx, tr, subject, d, sig),
    default_body: (n, cx, tr, d, sig, body) => cold.default_body(Counts { ..n, checked: n.checked + 1 }, cx, tr, d, sig, body),
    test_body: (n, cx, name, body) => cold.test_body(Counts { ..n, checked: n.checked + 1 }, cx, name, body)
  }
  let (count, bodies) = checker.execute_module_bodies(next, Counts { checked: 0, reused: 0 }, executor)
  Replayed { bodies: bodies, checked: count.checked, reused: count.reused }
}

test "scalar replay moves unchanged bodies through the current scheduler" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "fn answer() -> Int = 42\nfn other(x: Int) -> Int = x\n"
  let after = "type Added = { value: Int }\nfn other(x: Int) -> Int = x\n# moved\nfn answer() -> Int = 42\n"
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let new_syntax = source_snapshot.syntax(next_snapshot)
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, new_syntax, map.empty())
  let saved = body_execution.record(scope, old)
  assert saved.refused == 0
  assert snapshot_matches(old, old_snapshot) && snapshot_matches(next, next_snapshot)
  let sig = map.get(next.cx.fns, "answer").expect("answer header")
  let declaration = match new_syntax.decls[2] { DFn(d) -> d, _ -> panic("answer syntax") }
  assert parameters(declaration, sig) != None
  assert match table(scope, old) { Some(_) -> true, None -> false }
  assert match table(scope, next) { Some(_) -> true, None -> false }
  let admitted: AdmittedData = admit(scope, old, old_snapshot, saved)
  assert match prepare(admitted, next, next_snapshot) {
    Some(p) -> match candidate(p, next.cx, declaration, sig) { Some(_) -> true, None -> false }
    None -> false
  }
  # The index the preparation carries is the revision's own: on a real
  # candidate revision it answers every declared callee the way the scan it
  # replaced does.
  let prepared = prepare(admitted, next, next_snapshot).expect("prepared candidate")
  let no_trait: Option[Int] = None
  for (_, declared) in map.entries(next.cx.fns) {
    assert relocate_tree.callee_signature(prepared.callees, next.cx, declared.owner, declared.name, false, no_trait) ==
      relocate_tree.scanned_callee_signature(next.cx, declared.owner, declared.name, false, no_trait)
  }
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  assert actual.reused == 2 && actual.checked == 0
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.constants == expected.constants
  assert actual.bodies.cx.frame == expected.cx.frame
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
  assert actual.bodies.cx.diags == expected.cx.diags
  assert actual.bodies.cx.function_reads == expected.cx.function_reads
  assert actual.bodies.cx.body_writes == expected.cx.body_writes
}

test "scalar replay refuses a header that changed outside the declaration's own text" {
  # The two revisions spell `answer` with the same bytes, so the text half of
  # admission says yes. What changed is the alias its return type names, and
  # the signature is the only record of that: the recorded header has to
  # carry onto the candidate one field for field, or a body checked at `Int`
  # is reused for a declaration whose header says `Bool`.
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "alias Answer = Int\nfn answer() -> Answer = 42\n"
  let after = "alias Answer = Bool\nfn answer() -> Answer = 42\n"
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
  let saved = body_execution.record(scope, old)
  assert saved.refused == 0
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  assert actual.reused == 0 && actual.checked == 1
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.cx.diags == expected.cx.diags
}

test "scalar replay finds a product by the candidate declaration's identity" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "fn answer() -> Int = 42\nfn other(x: Int) -> Int = x\n"
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let saved = body_execution.record(scope, old)
  # A recorded product is reachable only under the key the enumeration gives
  # the candidate declaration in this revision. Reordering the declarations
  # keeps the keys and reuses both; renaming one leaves its product with no
  # key to be found under, and the other product is still found under its own.
  for (after, reused) in [
    ("fn answer() -> Int = 42\nfn other(x: Int) -> Int = x\n", 2),
    ("fn other(x: Int) -> Int = x\nfn answer() -> Int = 42\n", 2),
    ("fn renamed() -> Int = 42\nfn other(x: Int) -> Int = x\n", 1)
  ] {
    let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
    let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
    assert next.cx.diags == []
    let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
    let expected = checker.check_module_body_products(next)
    assert actual.reused == reused
    assert actual.bodies.functions == expected.functions
    assert actual.bodies.cx.syms == expected.cx.syms && actual.bodies.cx.decl_slots == expected.cx.decl_slots
  }
}

test "scalar replay revalidates recorded reads in place and through the projection" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let body = "fn compute(x: Int) -> Int = {\n let y = x + 1\n if y > 0 { y * 2 } else { -x }\n}\n"
  var compared = 0
  # The second pair shifts the candidate's allocation interval and every byte
  # offset, so agreement is asserted with the relocation carrying something.
  for (before, after) in [
    ("fn answer() -> Int = 42\nfn other(x: Int) -> Int = x\n",
      "type Added = { value: Int }\nfn other(x: Int) -> Int = x\n# moved\nfn answer() -> Int = 42\n"),
    ("fn prefix() -> Int = 0\n" ++ body,
      "type Added = { n: Int }\nfn prefix(a: Int, b: Int) -> Int = a + b\n# shifted\n" ++ body)
  ] {
    let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
    let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
    let new_syntax = source_snapshot.syntax(next_snapshot)
    let base = cx_new(Some("sample"), Some("sample.dawn"))
    let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
    let next = checker.check_module_headers(base, new_syntax, map.empty())
    let saved = body_execution.record(scope, old)
    let admitted: AdmittedData = admit(scope, old, old_snapshot, saved)
    let prepared = prepare(admitted, next, next_snapshot).expect("prepared candidate revision")
    for entry in identity.declarations(scope, new_syntax) {
      match new_syntax.decls[entry.declaration] {
        DFn(d) -> {
          let sig = map.get(next.cx.fns, d.name).expect("candidate header")
          match relocation(prepared, next.cx, d, sig) {
            Some((prior, view)) -> {
              let mapping = body_product.read_mapping(view, (owner, source) => None)
              let reads = prior.product.function_reads.expect("recorded log")
              let moved = body_product.projected_reads(view, prior.product, (owner, source) => None)
                .expect("projected log").expect("enabled log")
              assert len(moved) == len(reads) && len(reads) > 0
              var i = 0
              for read in reads {
                let in_place = checker.revalidate_read_under(mapping, next.cx, read)
                assert in_place == checker.revalidate_read(next.cx, moved[i])
                assert in_place == Some(true)
                compared = compared + 1
                i = i + 1
              }
            }
            None -> ()
          }
        }
        _ -> ()
      }
    }
  }
  assert compared == 3
}

test "scalar replay relocates lexical locals after changed allocation prefixes" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let body = "fn compute(x: Int) -> Int = {\n let y = x + 1\n if y > 0 { y * 2 } else { -x }\n}\n"
  let before = "fn prefix() -> Int = 0\n" ++ body
  let after = "type Added = { n: Int }\nfn prefix(a: Int, b: Int) -> Int = a + b\n# shifted\n" ++ body
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
  let saved = body_execution.record(scope, old)
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  assert actual.reused == 1 && actual.checked == 1
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
  assert actual.bodies.cx.frame == expected.cx.frame
  assert actual.bodies.cx.diags == expected.cx.diags
}

test "scalar replay refuses changed inputs and preserves current observation modes" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "fn answer() -> Int = 42\n"
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let saved = body_execution.record(scope, old)
  for (text, hits) in [
    ("# moved\nfn answer() -> Int = 42\n", 1),
    ("fn answer() -> Int = 43\n", 0),
    ("fn answer() -> Bool = true\n", 0),
    ("fn answer(x: Int) -> Int = x\n", 0),
    ("fn answer() = 42\n", 0),
    ("fn renamed() -> Int = 42\n", 0),
    ("fn answer() -> Int = { 42 }\n", 0)
  ] {
    let next_snapshot = source_snapshot.of(text).expect("candidate snapshot")
    let headers = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
    for logging in [false, true] {
      let next = ModuleHeaders { ..headers, cx: Cx { ..headers.cx,
        in_test: true, const_cutoff: Some(set.empty()), take_cell: Some(999),
        loop_jumps: set.from([999]), frame: Frame { ..headers.cx.frame, isolated: true },
        function_reads: if logging { Some([AssignableType(TyUnit, TyUnit, true)]) } else { None },
        body_writes: if logging { Some([]) } else { None } } }
      let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
      let expected = checker.check_module_body_products(next)
      assert actual.reused == hits && actual.checked == 1 - hits
      assert actual.bodies.functions == expected.functions
      assert actual.bodies.cx.frame == expected.cx.frame
      assert actual.bodies.cx.in_test == expected.cx.in_test
      assert actual.bodies.cx.const_cutoff == expected.cx.const_cutoff
      assert actual.bodies.cx.take_cell == expected.cx.take_cell
      assert actual.bodies.cx.loop_jumps == expected.cx.loop_jumps
      assert actual.bodies.cx.function_reads == expected.cx.function_reads
      assert actual.bodies.cx.body_writes == expected.cx.body_writes
      assert actual.bodies.cx.diags == expected.cx.diags
      let trailing = source_snapshot.of(before ++ "# wrong snapshot\n").expect("trailing comment")
      let mismatch = replay(admit(scope, old, trailing, saved), next, next_snapshot)
      # A different comment-only snapshot parses to the same tree and is safe:
      # its body coordinates are unchanged. Changed parsed input is not.
      assert mismatch.reused == hits
      let wrong = source_snapshot.of("fn wrong() -> Int = 42\n").expect("unrelated module")
      let unrelated = replay(admit(scope, old, wrong, saved), next, next_snapshot)
      assert unrelated.reused == 0 && unrelated.checked == 1
      let added = source_snapshot.of(before ++ "fn extra() -> Int = 0\n").expect("added declaration")
      let extra = replay(admit(scope, old, added, saved), next, next_snapshot)
      assert extra.reused == 0 && extra.checked == 1
    }
  }
}

test "scalar replay refuses binders that shadow candidate module aliases" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let dep_syntax = source_snapshot.syntax(
    source_snapshot.of("pub fn one() -> Int = 1\n").expect("dependency snapshot"))
  let (dep_cx, _) = checker.check_module(cx_new(Some("dep"), Some("dep.dawn")), dep_syntax, map.empty())
  assert dep_cx.diags == []
  let env = map.from([("dep", checker.exports_of(dep_cx, dep_syntax, "dep", "dep"))])
  let before = "fn compute(x: Int) -> Int = {\n let y = x + 1\n y\n}\n"
  let after = "use dep as y\n" ++ before
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), env)
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), env)
  assert old.cx.diags == [] && next.cx.diags == []
  assert map.has(next.cx.module_aliases, "y")
  let saved = body_execution.record(scope, old)
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  let cold_diags: Int = len(expected.cx.diags)
  assert cold_diags == 1
  assert actual.reused == 0 && actual.checked == 1
  assert actual.bodies.cx.diags == expected.cx.diags
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.cx.syms == expected.cx.syms
}

test "scalar replay refuses a declaration whose own text changed" {
  # `answer` only moved, so its saved body is admitted: its spans are offsets
  # into text that did not change. `other` lexes to the same tokens but gained
  # a space inside it, which moved every offset into its interior. It is
  # checked cold, and the two functions together are what the cold check would
  # have produced. Drop the byte comparison at the admission point and the
  # second one comes back with the offsets of the revision it was recorded
  # from, which this comparison reads.
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "fn answer() -> Int = 42\nfn other(x: Int) -> Int = x\n"
  let after = "# moved\nfn answer() -> Int = 42\nfn other(x: Int) -> Int =  x\n"
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
  assert old.cx.diags == [] && next.cx.diags == []
  let saved = body_execution.record(scope, old)
  assert saved.refused == 0
  # the token pairing alone cannot tell these two declarations apart
  let old_tokens = source_snapshot.tokens(old_snapshot)
  let next_tokens = source_snapshot.tokens(next_snapshot)
  let old_other = match source_snapshot.syntax(old_snapshot).decls[1] { DFn(d) -> d, _ -> panic("other") }
  let new_other = match source_snapshot.syntax(next_snapshot).decls[1] { DFn(d) -> d, _ -> panic("other") }
  assert source_projection.pair(old_tokens, next_tokens, 1, 1,
    old_other.lo, old_other.hi, new_other.lo, new_other.hi)
  assert not source_projection.same_text(old_tokens, next_tokens,
    old_other.lo, old_other.hi, new_other.lo, new_other.hi)
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  assert actual.reused == 1 && actual.checked == 1
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
}

test "scalar replay refuses re-parsed statement boundaries with equal tokens" {
  let scope = identity.module_key("scalar", "sample", "sample", "sample.dawn")
  let before = "fn compute(x: Int) -> Int = {\n let a = 1\n let b = a\n - x\n}\n"
  let after = "fn compute(x: Int) -> Int = {\n let a = 1\n let b = a - x\n}\n"
  let old_snapshot = source_snapshot.of(before).expect("recorded snapshot")
  let next_snapshot = source_snapshot.of(after).expect("candidate snapshot")
  let base = cx_new(Some("sample"), Some("sample.dawn"))
  let old = checker.check_module_headers(base, source_snapshot.syntax(old_snapshot), map.empty())
  let next = checker.check_module_headers(base, source_snapshot.syntax(next_snapshot), map.empty())
  assert old.cx.diags == [] && next.cx.diags == []
  assert snapshot_matches(old, old_snapshot) && snapshot_matches(next, next_snapshot)
  let saved = body_execution.record(scope, old)
  assert saved.refused == 0
  let actual = replay(admit(scope, old, old_snapshot, saved), next, next_snapshot)
  let expected = checker.check_module_body_products(next)
  let cold_diags: Int = len(expected.cx.diags)
  assert cold_diags == 1
  assert actual.reused == 0 && actual.checked == 1
  assert actual.bodies.functions == expected.functions
  assert actual.bodies.cx.diags == expected.cx.diags
  assert actual.bodies.cx.syms == expected.cx.syms
  assert actual.bodies.cx.decl_slots == expected.cx.decl_slots
}
