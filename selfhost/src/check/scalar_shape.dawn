# Which parsed bodies the scalar replay class supports, decided once beside
# the recording. Admission does not pair two parsed trees: the candidate
# declaration's own bytes have to be unchanged, so it parses to the recorded
# tree, and what remains to ask is whether that tree is in the class at all.
use front/ast.{Expr, EInt, EFloat, EBool, EUnit, EVar, EUnary, EBinary, EIf, EBlock, SLet, OpNeg,
  OpAdd, TNamed }

## checker.declare reports a binder that shadows an imported module alias, and
## that read of the alias table leaves no journal entry. Collect every name the
## admitted class declares so admission can ask the candidate revision the same
## question. This walk is also where class membership is decided: it fails
## closed on every node the class does not support, so extending the class
## without extending this collector refuses rather than dropping the
## diagnostic.
pub fn binders(e: Expr, into: List[String]) -> Option[List[String]] = match e {
  EInt(_, _, _) -> Some(into)
  EFloat(_, _, _) -> Some(into)
  EBool(_, _, _) -> Some(into)
  EUnit(_, _) -> Some(into)
  EVar(_, _, _) -> Some(into)
  EUnary(_, x, _, _) -> binders(x, into)
  EBinary(_, x, y, _, _, _, _) -> binders(y, binders(x, into)?)
  EIf(c, x, y, _, _) -> optional_binders(y, binders(x, binders(c, into)?)?)
  EBlock(xs, tail, _, _) -> {
    var out = into
    for s in xs {
      match s {
        # A declared type on the binding is in the class, and what it names
        # is not decided here: resolving it is a read like any other, so the
        # recorded log carries the answer and the replay path revalidates it.
        # A body that names something the read allowlist does not cover is
        # refused where that allowlist is, which is where every other question
        # about what an admitted body may say is answered.
        SLet(name, false, _, init, _, _) -> { out = binders(init, out)? ++ [name] }
        _ -> return None
      }
    }
    optional_binders(tail, out)
  }
  _ -> None
}

fn optional_binders(e: Option[Expr], into: List[String]) -> Option[List[String]] = match e {
  None -> Some(into)
  Some(x) -> binders(x, into)
}

test "scalar shape collects every declared binder and refuses unpaired nodes" {
  let x = EVar("x", 0, 1)
  assert binders(x, ["x"]) == Some(["x"])
  let inner = EBlock([SLet("b", false, None, x, 0, 2)], Some(EVar("b", 0, 1)), 0, 3)
  let branch = EIf(EBool(true, 0, 1), inner, Some(EUnary(OpNeg, x, 0, 2)), 0, 4)
  let nested = EBlock([SLet("a", false, None, EInt(1, 0, 1), 0, 2)], Some(branch), 0, 5)
  assert binders(nested, []) == Some(["a", "b"])
  assert binders(EBlock([SLet("m", true, None, x, 0, 2)], Some(x), 0, 3), []) == None
  let annotated = EBlock([SLet("t", false, Some(TNamed("T", [], [], 0, 1)), x, 0, 2)],
    Some(EVar("t", 0, 1)), 0, 3)
  assert binders(annotated, []) == Some(["t"])
  assert binders(EBlock([], Some(EBinary(OpAdd, x, x, 0, 1, 0, 2)), 0, 3), []) == Some([])
}
